              <calculation class='tableau' formula='IF SUM([Sales_MoM_Variance]) &gt; 0 THEN &apos;Positive&apos;&#13;&#10;   ELSEIF SUM([Sales_MoM_Variance]) &lt; 0 THEN &apos;Negative&apos;&#13;&#10;   ELSE &apos;Flat&apos;&#13;&#10;   END' />
