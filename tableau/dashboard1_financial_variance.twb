              <calculation class='tableau' formula='IF SUM([Forecast_vs_Actual_Delta]) &gt; 0 THEN &apos;Beat Forecast&apos;&#13;&#10;   ELSEIF SUM([Forecast_vs_Actual_Delta]) &lt; 0 THEN &apos;Missed Forecast&apos;&#13;&#10;   ELSE &apos;On Target&apos;&#13;&#10;   END' />
