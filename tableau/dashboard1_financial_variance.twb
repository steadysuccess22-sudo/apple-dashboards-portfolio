      <aliases enabled='yes' />
      <column caption='Blended Margin %' datatype='real' name='[Calculation_2013759061733376]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit]) / SUM([Sales])' />
      </column>
      <column caption='YoY Sales Change %' datatype='real' name='[Calculation_2013759062671361]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Sales]) - SUM([Sales_Prior_Year])) / SUM([Sales_Prior_Year])' />
      </column>
      <column caption='Sales Combined' datatype='real' name='[Calculation_2013759066591234]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([Sales], [Sales_Forecast])' />
      </column>
      <column caption='Net Variance Direction' datatype='string' name='[Calculation_2013759070957571]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Sales_MoM_Variance]) &gt; 0 THEN &apos;Positive&apos;&#13;&#10;   ELSEIF SUM([Sales_MoM_Variance]) &lt; 0 THEN &apos;Negative&apos;&#13;&#10;   ELSE &apos;Flat&apos;&#13;&#10;   END' />
      </column>
      <column caption='One' datatype='integer' name='[Calculation_2013759074078724]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Forecast Accuracy Direction' datatype='string' name='[Calculation_2013759081910277]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Forecast_vs_Actual_Delta]) &gt; 0 THEN &apos;Beat Forecast&apos;&#13;&#10;   ELSEIF SUM([Forecast_vs_Actual_Delta]) &lt; 0 THEN &apos;Missed Forecast&apos;&#13;&#10;   ELSE &apos;On Target&apos;&#13;&#10;   END' />
      </column>
      <column caption='Forecast vs Actual Delta' datatype='real' name='[Forecast_vs_Actual_Delta]' role='measure' type='quantitative' />
